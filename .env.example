# Copiar a .env y cambiar los valores (el .env NO se sube a Git)
POSTGRES_USER=cuidarte
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=cuidarte

# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar_por_valor_aleatorio_de_64_caracteres
# NFR-SEG-9: token de corta vigencia
JWT_EXPIRES_IN=15m

# NFR-SEG-3: clave AES-256 para cifrado en reposo. Generar con: openssl rand -hex 32
# Si se pierde esta clave, los datos cifrados NO se pueden recuperar.
DATA_ENCRYPTION_KEY=cambiar_por_64_caracteres_hexadecimales